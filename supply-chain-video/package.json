{
  "name": "supply-chain-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéo animée de chaîne d'approvisionnement (Remotion 4 + Mapbox GL JS)",
  "scripts": {
    "dev": "remotion studio",
    "render:origine": "remotion render SupplyChainVertical out/origine.mp4 --props='{\"stepsPath\":\"steps-origine.json\",\"brandPath\":\"brand.json\"}'",
    "render:terroir": "remotion render SupplyChainVertical out/terroir.mp4 --props='{\"stepsPath\":\"steps-terroir.json\",\"brandPath\":\"brand-terroir.json\"}'",
    "render:origine:16x9": "remotion render SupplyChainHorizontal out/origine-16x9.mp4 --props='{\"stepsPath\":\"steps-origine.json\",\"brandPath\":\"brand.json\"}'",
    "render:terroir:16x9": "remotion render SupplyChainHorizontal out/terroir-16x9.mp4 --props='{\"stepsPath\":\"steps-terroir.json\",\"brandPath\":\"brand-terroir.json\"}'",
    "render": "npm run render:origine && npm run render:terroir",
    "test": "node --import tsx --test src/*.test.ts",
    "check:route": "tsx scripts/check-route.ts public/steps-origine.json && tsx scripts/check-route.ts public/steps-terroir.json --svg out/route-check-terroir.svg",
    "assets:placeholders": "remotion still scripts/placeholders/index.tsx logo public/logo.png && remotion still scripts/placeholders/index.tsx farm public/farm.jpg && remotion still scripts/placeholders/index.tsx roaster public/roaster.jpg && python3 scripts/make-placeholder-music.py 60",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts"
  },
  "license": "MIT",
  "dependencies": {
    "@remotion/cli": "^4.0.525",
    "@turf/turf": "^7.4.0",
    "mapbox-gl": "^3.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.525"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.525",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.39.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "world-atlas": "^2.0.2"
  }
}
