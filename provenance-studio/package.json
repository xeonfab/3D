{
  "name": "provenance-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > lib/supabase/types.ts",
    "format": "prettier --write .",
    "test:sql": "bash scripts/test-sql.sh",
    "remotion:studio": "remotion studio",
    "remotion:render": "remotion render vertical out/test-vertical.mp4 --props=remotion/sample-props.json",
    "remotion:lambda:deploy": "remotion lambda functions deploy --memory=3009 --timeout=240 --disk=2048 && remotion lambda sites create remotion/index.ts --site-name=provenance-studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@remotion/bundler": "^4.0.525",
    "@remotion/cli": "^4.0.525",
    "@remotion/fonts": "^4.0.525",
    "@remotion/lambda": "^4.0.525",
    "@remotion/renderer": "^4.0.525",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/distance": "^7.4.0",
    "@turf/great-circle": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-slice-along": "^7.4.0",
    "@turf/turf": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "mapbox-gl": "^3.30.0",
    "next": "15.5.25",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "^4.0.525",
    "resend": "^6.28.1",
    "searoute-js": "^0.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
