# ---------------------------------------------------------------------------
# Provenance Studio — variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez chaque valeur.
# Aucune valeur ci-dessous n'est un secret réel.
# ---------------------------------------------------------------------------

# URL publique du site (utilisée pour les liens dans les emails et les QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « anon » (ou « publishable » sur les projets récents)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (ou « secret ») — serveur uniquement, jamais exposée
SUPABASE_SERVICE_ROLE_KEY=
# Référence du projet, pour `npm run db:types`
SUPABASE_PROJECT_ID=

# --- Mapbox (compte → Access tokens) ----------------------------------------
# Token public restreint aux URL du site (styles + geocoding)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.

# --- Rendu vidéo ---------------------------------------------------------------
# lambda (production, défaut) ou local (développement : worker sur cette machine)
RENDER_PROVIDER=lambda

# Remotion Lambda (AWS) — voir README « Remotion Lambda »
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=eu-west-3
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=

# Worker local (RENDER_PROVIDER=local) : Chrome à utiliser et mode WebGL
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/google-chrome
# REMOTION_CHROME_MODE=chrome-for-testing   # ou headless-shell (défaut)
# REMOTION_GL=swangle                        # machine sans GPU

# --- Stripe — phase 5 --------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO_MONTHLY=price_

# --- Resend (emails transactionnels) — phase 3 -------------------------------
RESEND_API_KEY=re_
RESEND_FROM_EMAIL="Provenance Studio <bonjour@votre-domaine.fr>"

# --- Jeu de données de développement (`npm run seed`) ------------------------
SEED_OWNER_EMAIL=vous@votre-marque.fr
